---
import Header from "./Header.astro";
import { locales, type Locale } from "../i18n/locales";
import { t } from "../i18n/ui";
import { absoluteUrl, getSiteBase, jsonLdScript, siteImagePath } from "../lib/seo";
import "katex/dist/katex.min.css";

type Props = {
  lang: Locale;
  title?: string;
  description?: string;
  pathname?: string;
  availableLocales?: Locale[];
  canonicalPath?: string;
  image?: string;
  pageType?: "website" | "article";
  robots?: string;
  jsonLd?: unknown | unknown[];
};

const {
  lang,
  title = t(lang, "siteTitle"),
  description = t(lang, "siteDescription"),
  pathname = Astro.url.pathname,
  availableLocales,
  canonicalPath = pathname,
  image = siteImagePath,
  pageType = "website",
  robots = "index, follow",
  jsonLd = []
} = Astro.props;

const pageTitle = title === t(lang, "siteTitle") ? title : `${title} | ${t(lang, "siteTitle")}`;
const siteBase = getSiteBase(Astro.site);
const canonicalUrl = absoluteUrl(canonicalPath, siteBase);
const imageUrl = absoluteUrl(image, siteBase);
const structuredData = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
const alternateLocales = availableLocales ?? [];
const alternateHref = (locale: Locale) => absoluteUrl(pathname.replace(`/${lang}`, `/${locale}`), siteBase);
---

<!doctype html>
<html lang={locales[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#f8fafc" />
    <meta property="og:site_name" content={t(lang, "siteTitle")} />
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={locales[lang].htmlLang} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/icon-192.png" type="image/png" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("rcl-theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = stored ?? (prefersDark ? "dark" : "light");
      })();
    </script>
    {alternateLocales.map((locale) => (
      <link rel="alternate" hreflang={locales[locale].htmlLang} href={alternateHref(locale)} />
    ))}
    {alternateLocales.includes("en") ? <link rel="alternate" hreflang="x-default" href={alternateHref("en")} /> : null}
    {structuredData.map((item) => <script is:inline type="application/ld+json" set:html={jsonLdScript(item)} />)}
  </head>
  <body>
    <Header lang={lang} pathname={pathname} availableLocales={availableLocales} />
    <main class="page-shell">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --rcl-bg: #f8fafc;
    --rcl-bg-soft: #eef5ff;
    --rcl-surface: #ffffff;
    --rcl-surface-elevated: #fdfefe;
    --rcl-surface-lab: #f5f9ff;
    --rcl-text: #102033;
    --rcl-text-muted: #5b6b7f;
    --rcl-text-soft: #7b8794;
    --rcl-text-inverse: #ffffff;
    --rcl-primary: #2563eb;
    --rcl-primary-strong: #1d4ed8;
    --rcl-primary-soft: #dbeafe;
    --rcl-secondary: #f97316;
    --rcl-secondary-strong: #ea580c;
    --rcl-secondary-soft: #ffedd5;
    --rcl-accent: #22c55e;
    --rcl-accent-strong: #16a34a;
    --rcl-accent-soft: #dcfce7;
    --rcl-border: #d8e2ee;
    --rcl-border-strong: #b7c7dc;
    --rcl-grid: rgba(37, 99, 235, 0.08);
    --rcl-warning: #f59e0b;
    --rcl-error: #ef4444;
    --rcl-success: #22c55e;
    --rcl-radius-sm: 8px;
    --rcl-radius-md: 14px;
    --rcl-radius-lg: 20px;
    --rcl-radius-xl: 28px;
    --rcl-shadow-sm: 0 4px 12px rgba(15, 23, 42, 0.06);
    --rcl-shadow-md: 0 12px 32px rgba(15, 23, 42, 0.08);
    --rcl-shadow-lg: 0 24px 64px rgba(15, 23, 42, 0.1);
    --rcl-glow-blue: 0 0 28px rgba(37, 99, 235, 0.18);
    --rcl-glow-orange: 0 0 28px rgba(249, 115, 22, 0.22);
    --rcl-motion-fast: 120ms;
    --rcl-motion-normal: 220ms;
    --rcl-ease-standard: cubic-bezier(0.2, 0, 0, 1);
    --bg: var(--rcl-bg);
    --surface: var(--rcl-surface);
    --surface-muted: var(--rcl-bg-soft);
    --text: var(--rcl-text);
    --muted: var(--rcl-text-muted);
    --line: var(--rcl-border);
    --accent: var(--rcl-primary);
    --accent-strong: var(--rcl-primary-strong);
    --warning: var(--rcl-secondary-strong);
    --radius: var(--rcl-radius-md);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
  }

  :root[data-theme="dark"] {
    color-scheme: dark;
    --rcl-bg: #08111f;
    --rcl-bg-soft: #0d1b2f;
    --rcl-surface: #101c2e;
    --rcl-surface-elevated: #14243a;
    --rcl-surface-lab: #0d1b2f;
    --rcl-text: #e5edf7;
    --rcl-text-muted: #9fb0c3;
    --rcl-text-soft: #7f91a8;
    --rcl-text-inverse: #08111f;
    --rcl-primary: #60a5fa;
    --rcl-primary-strong: #93c5fd;
    --rcl-primary-soft: rgba(96, 165, 250, 0.16);
    --rcl-secondary: #fb923c;
    --rcl-secondary-strong: #fdba74;
    --rcl-secondary-soft: rgba(251, 146, 60, 0.16);
    --rcl-accent: #4ade80;
    --rcl-accent-strong: #86efac;
    --rcl-accent-soft: rgba(74, 222, 128, 0.16);
    --rcl-border: #26384f;
    --rcl-border-strong: #38516f;
    --rcl-grid: rgba(96, 165, 250, 0.08);
    --rcl-shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.18);
    --rcl-shadow-md: 0 12px 32px rgba(0, 0, 0, 0.24);
    --rcl-shadow-lg: 0 24px 64px rgba(0, 0, 0, 0.32);
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background:
      radial-gradient(circle at top left, color-mix(in srgb, var(--rcl-secondary) 11%, transparent), transparent 32rem),
      linear-gradient(180deg, var(--rcl-bg-soft), var(--rcl-bg) 28rem);
    color: var(--text);
    line-height: 1.65;
  }

  a {
    color: var(--accent-strong);
  }

  button,
  a {
    outline-offset: 3px;
  }

  .page-shell {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
    padding: 36px 0 64px;
  }

  .rcl-graph-paper {
    background-image:
      linear-gradient(var(--rcl-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--rcl-grid) 1px, transparent 1px);
    background-size: 32px 32px;
  }

  .section-kicker {
    color: var(--rcl-secondary-strong);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    margin: 0 0 8px;
    text-transform: uppercase;
  }

  .rcl-button-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .rcl-button {
    align-items: center;
    background: var(--rcl-primary);
    border: 1px solid var(--rcl-primary);
    border-radius: 999px;
    color: var(--rcl-text-inverse);
    display: inline-flex;
    font-weight: 850;
    justify-content: center;
    min-height: 44px;
    padding: 9px 16px;
    text-decoration: none;
    transition:
      background var(--rcl-motion-fast) var(--rcl-ease-standard),
      border-color var(--rcl-motion-fast) var(--rcl-ease-standard),
      transform var(--rcl-motion-fast) var(--rcl-ease-standard);
  }

  .rcl-button:hover {
    background: var(--rcl-primary-strong);
    border-color: var(--rcl-primary-strong);
    transform: translateY(-1px);
  }

  .rcl-button.secondary {
    background: var(--surface);
    border-color: var(--line);
    color: var(--text);
  }

  .rcl-button.secondary:hover {
    border-color: var(--rcl-secondary);
    color: var(--rcl-secondary-strong);
  }

  .prose {
    max-width: 760px;
  }

  .prose h1,
  .prose h2,
  .prose h3 {
    line-height: 1.2;
  }

  .prose h1 {
    font-size: clamp(2rem, 4vw, 3.75rem);
    margin: 0 0 12px;
  }

  .prose h2 {
    margin-top: 42px;
  }

  .summary {
    color: var(--muted);
    font-size: 1.1rem;
  }

  .surface {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--rcl-shadow-sm);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }

  .status {
    color: var(--rcl-secondary-strong);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  pre {
    overflow-x: auto;
    border-radius: var(--radius);
    padding: 16px;
    background: #0f172a;
    color: #e2e8f0;
  }

  .katex-display {
    margin: 1.25rem 0;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.25rem 0;
  }

  .katex-display > .katex {
    white-space: nowrap;
  }

  .graph-explorer,
  .graph-basics-figure,
  .graph-basics-explorer,
  .graph-representation-compare,
  .queue-wave-demo,
  .bfs-scenario-figure,
  .dijkstra-trace-demo,
  .dijkstra-scenario-figure,
  .graham-scan-demo,
  .graham-scenario-figure,
  .closest-pair-demo,
  .closest-scenario-figure,
  .bentley-demo,
  .bentley-scenario-figure,
  .pnp-figure,
  .pnp-demo {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--rcl-radius-lg);
    box-shadow: var(--rcl-shadow-sm);
    margin: 24px 0;
    padding: 18px;
  }

  .graph-basics-explorer,
  .queue-wave-demo,
  .dijkstra-trace-demo,
  .graham-scan-demo,
  .closest-pair-demo,
  .bentley-demo,
  .pnp-demo {
    background:
      linear-gradient(color-mix(in srgb, var(--rcl-surface-lab) 86%, transparent), color-mix(in srgb, var(--surface) 94%, transparent)),
      linear-gradient(var(--rcl-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--rcl-grid) 1px, transparent 1px);
    background-size: auto, 28px 28px, 28px 28px;
  }

  .graph-header h2,
  .graph-list h2 {
    margin: 0;
  }

  .graph-header {
    align-items: start;
    display: flex;
    gap: 16px;
    justify-content: space-between;
  }

  .graph-preview-link {
    background: var(--rcl-primary);
    border: 1px solid var(--rcl-primary);
    border-radius: 999px;
    color: var(--rcl-text-inverse);
    font-size: 0.9rem;
    font-weight: 850;
    padding: 7px 12px;
    text-decoration: none;
    white-space: nowrap;
  }

  .graph-preview-link.disabled {
    background: var(--surface-muted);
    border-color: var(--line);
    color: var(--muted);
  }

  .graph-explorer svg {
    display: block;
    height: auto;
    margin-top: 16px;
    max-width: 100%;
    touch-action: none;
    user-select: none;
    width: 100%;
  }

  .graph-explorer .edge {
    fill: none;
    pointer-events: none;
    stroke: var(--rcl-primary);
    stroke-width: 2;
    transition: opacity 160ms ease, stroke-width 160ms ease;
  }

  .graph-explorer .edge.active {
    opacity: 1;
    stroke-width: 4;
  }

  .graph-explorer .edge.dimmed {
    opacity: 0.16;
  }

  .graph-explorer .edge-uses,
  .graph-explorer .edge-implemented-by,
  .graph-explorer .edge-applied-in {
    stroke: var(--rcl-accent);
  }

  .graph-explorer .edge-motivates,
  .graph-explorer .edge-fails-when {
    stroke: var(--rcl-secondary);
  }

  .graph-explorer .edge-contrasts,
  .graph-explorer .edge-special-case {
    stroke-dasharray: 7 6;
  }

  .graph-explorer marker path {
    fill: var(--muted);
  }

  .graph-explorer text {
    fill: var(--text);
    font-size: 13px;
    pointer-events: none;
  }

  .graph-viewbar {
    align-items: center;
    border-top: 1px solid var(--line);
    display: flex;
    gap: 12px;
    justify-content: space-between;
    margin-top: 12px;
    padding-top: 12px;
  }

  .graph-viewbar p {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0;
  }

  .graph-search {
    align-items: center;
    display: flex;
    gap: 8px;
    margin-left: auto;
    min-width: min(260px, 100%);
  }

  .graph-search label {
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 850;
    white-space: nowrap;
  }

  .graph-search input {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--rcl-radius-sm);
    color: var(--text);
    font: inherit;
    height: 36px;
    min-width: 0;
    padding: 0 10px;
    width: 180px;
  }

  .graph-search input:focus {
    border-color: var(--rcl-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--rcl-primary) 18%, transparent);
    outline: none;
  }

  .graph-search-results {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .graph-search-results button {
    align-items: center;
    background: color-mix(in srgb, var(--rcl-success) 10%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--rcl-success) 36%, var(--line));
    border-radius: var(--rcl-radius-sm);
    color: var(--text);
    cursor: pointer;
    display: inline-flex;
    font: inherit;
    gap: 8px;
    min-height: 34px;
    padding: 6px 10px;
  }

  .graph-search-results button:hover,
  .graph-search-results button:focus-visible {
    border-color: var(--rcl-success);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--rcl-success) 18%, transparent);
    outline: none;
  }

  .graph-search-results small {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .graph-search-results p {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0;
  }

  .graph-view-controls {
    align-items: center;
    display: flex;
    gap: 8px;
  }

  .graph-view-controls button {
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--rcl-radius-sm);
    color: var(--text);
    cursor: pointer;
    display: inline-flex;
    font: inherit;
    font-weight: 800;
    height: 34px;
    justify-content: center;
    min-width: 34px;
    padding: 0 10px;
  }

  .graph-view-controls button:hover,
  .graph-view-controls button:focus-visible {
    border-color: var(--rcl-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--rcl-primary) 18%, transparent);
    outline: none;
  }

  .graph-view-controls output {
    color: var(--muted);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    min-width: 42px;
    text-align: center;
  }

  .graph-pan-surface {
    cursor: grab;
    fill: transparent;
  }

  .graph-explorer svg:active .graph-pan-surface {
    cursor: grabbing;
  }

  .edge-label rect {
    fill: color-mix(in srgb, var(--surface) 92%, transparent);
    pointer-events: none;
    stroke: var(--line);
    stroke-width: 1;
  }

  .edge-label text {
    fill: var(--muted);
    font-size: 10px;
    font-weight: 750;
    text-transform: uppercase;
  }

  .edge-label {
    transition: opacity 160ms ease;
  }

  .edge-label.active rect {
    fill: color-mix(in srgb, var(--rcl-primary) 12%, var(--surface));
    stroke: var(--rcl-primary);
  }

  .edge-label.active text {
    fill: var(--rcl-primary-strong);
  }

  .edge-label.dimmed {
    opacity: 0.18;
  }

  .svg-node {
    cursor: pointer;
  }

  .svg-node rect {
    fill: var(--surface-muted);
    stroke: var(--line);
    stroke-width: 2;
    transition: fill 160ms ease, stroke 160ms ease, stroke-width 160ms ease;
  }

  .svg-node rect.selected,
  .svg-node:focus rect {
    fill: color-mix(in srgb, var(--accent) 18%, var(--surface));
    stroke: var(--accent);
    stroke-width: 3;
  }

  .svg-node rect.search-match {
    fill: color-mix(in srgb, var(--rcl-success) 18%, var(--surface));
    stroke: var(--rcl-success);
    stroke-width: 4;
  }

  .svg-node rect.hovered {
    stroke: var(--rcl-primary);
    stroke-width: 4;
  }

  .svg-node:focus {
    outline: none;
  }

  .svg-node:hover rect {
    stroke: var(--rcl-primary);
  }

  @media (max-width: 760px) {
    .graph-viewbar {
      align-items: stretch;
      flex-direction: column;
    }

    .graph-search {
      margin-left: 0;
      width: 100%;
    }

    .graph-search input {
      flex: 1;
      width: auto;
    }

    .graph-view-controls {
      justify-content: flex-start;
    }
  }

  .graph-explorer .node-title {
    font-size: 13px;
    font-weight: 850;
  }

  .graph-explorer .node-meta {
    fill: var(--muted);
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .graph-list {
    border-top: 1px solid var(--line);
    margin-top: 18px;
    padding-top: 18px;
  }

  .selected-card {
    background: var(--surface-muted);
    border: 1px solid var(--line);
    border-radius: var(--rcl-radius-md);
    margin-top: 16px;
    padding: 14px;
  }

  .selected-card h3 {
    margin: 0 0 4px;
  }

  .selected-card p {
    color: var(--rcl-secondary-strong);
    font-size: 0.85rem;
    font-weight: 850;
    margin: 0 0 8px;
    text-transform: uppercase;
  }

  .selected-card ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding-left: 18px;
  }

  .graph-list li + li {
    margin-top: 12px;
  }

  .graph-list p {
    color: var(--muted);
    margin: 4px 0 0;
  }

  .demo-grid {
    display: grid;
    gap: 18px;
    grid-template-columns: minmax(260px, 1fr) minmax(220px, 0.9fr);
  }

  .queue-wave-demo svg {
    width: 100%;
  }

  .graph-basics-figure,
  .bfs-scenario-figure,
  .dijkstra-scenario-figure,
  .pnp-figure,
  .pnp-demo {
    display: grid;
    gap: 12px;
  }

  .graph-basics-figure figcaption,
  .bfs-scenario-figure figcaption,
  .dijkstra-scenario-figure figcaption,
  .pnp-figure figcaption {
    display: grid;
    gap: 4px;
    margin: 0;
  }

  .graph-basics-figure figcaption span,
  .bfs-scenario-figure figcaption span,
  .dijkstra-scenario-figure figcaption span,
  .pnp-figure figcaption span {
    color: var(--muted);
  }

  .graph-basics-figure svg,
  .graph-basics-explorer svg,
  .bfs-scenario-figure svg,
  .dijkstra-scenario-figure svg,
  .dijkstra-trace-demo svg,
  .pnp-figure svg {
    display: block;
    height: auto;
    width: 100%;
  }

  .graph-basics-figure line,
  .graph-basics-explorer line,
  .bfs-scenario-figure line,
  .dijkstra-scenario-figure line,
  .dijkstra-trace-demo line,
  .pnp-figure line {
    stroke: var(--line);
    stroke-linecap: round;
    stroke-width: 3;
  }

  .graph-basics-figure line.highlighted,
  .graph-basics-figure line.variant,
  .graph-basics-explorer line.active,
  .bfs-scenario-figure line.active,
  .dijkstra-scenario-figure line.active,
  .dijkstra-trace-demo line.active {
    stroke: #0f766e;
    stroke-width: 5;
  }

  .graph-basics-figure marker path,
  .bfs-scenario-figure marker path,
  .dijkstra-scenario-figure marker path {
    fill: #0f766e;
  }

  .graph-basics-figure circle,
  .graph-basics-explorer circle,
  .bfs-scenario-figure circle,
  .dijkstra-scenario-figure circle,
  .dijkstra-trace-demo circle {
    fill: var(--surface-muted);
    stroke: var(--line);
    stroke-width: 2;
  }

  .graph-basics-figure circle.active,
  .graph-basics-explorer circle.selected,
  .bfs-scenario-figure circle.current,
  .dijkstra-scenario-figure circle.current,
  .dijkstra-trace-demo circle.current {
    fill: #99f6e4;
    stroke: #0f766e;
    stroke-width: 4;
  }

  .graph-basics-explorer circle.neighbor,
  .bfs-scenario-figure circle.queued,
  .queue-wave-demo circle.queued,
