---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../i18n/locales";
import { nodePath } from "../lib/routes";
import { t } from "../i18n/ui";

type Props = {
  entry: CollectionEntry<"nodes">;
  lang: Locale;
};

const { entry, lang } = Astro.props;
---

<article class="node-card surface">
  <p class="status">{t(lang, entry.data.status)}</p>
  <h2><a href={nodePath(lang, entry.data.id)}>{entry.data.title}</a></h2>
  <p>{entry.data.summary}</p>
  <a class="read-more" href={nodePath(lang, entry.data.id)}>{t(lang, "readMore")}</a>
</article>

<style>
  .node-card {
    display: grid;
    gap: 10px;
    padding: 18px;
    transition:
      border-color var(--rcl-motion-fast) var(--rcl-ease-standard),
      transform var(--rcl-motion-fast) var(--rcl-ease-standard);
  }

  .node-card:hover {
    border-color: color-mix(in srgb, var(--rcl-primary) 45%, var(--line));
    transform: translateY(-2px);
  }

  .node-card h2 {
    font-size: 1.15rem;
    line-height: 1.25;
    margin: 0;
  }

  .node-card h2 a {
    color: var(--text);
    text-decoration: none;
  }

  .node-card p {
    color: var(--muted);
    margin: 0;
  }

  .read-more {
    color: var(--rcl-primary-strong);
    font-weight: 700;
    margin-top: 4px;
  }
</style>
