---
import Layout from "../../components/Layout.astro";
import NodeCard from "../../components/NodeCard.astro";
import { localeCodes, type Locale } from "../../i18n/locales";
import { t } from "../../i18n/ui";
import { graphPath, nodePath, roadmapPath } from "../../lib/routes";
import { getNodesByLocale } from "../../lib/content";
import { absoluteUrl, getSiteBase, organizationJsonLd, websiteJsonLd } from "../../lib/seo";

export function getStaticPaths() {
  return localeCodes.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const nodes = await getNodesByLocale(lang);
const featured = nodes.slice(0, 4);
const siteBase = getSiteBase(Astro.site);

const copy = {
  en: {
    kicker: "Explorable lab notebook",
    headline: "Re-invent computer science visually.",
    intro:
      "Start from a concrete problem, test the naive idea, watch it fail, then build the smallest useful abstraction with interactive traces.",
    codeLabel: "trace snapshot",
    annotation: "try a naive approach",
    steps: [
      ["Problem", "Begin with a small pressure point instead of a definition."],
      ["Failure", "Make the first idea visible enough to see where it breaks."],
      ["Invention", "Introduce one new tool that removes the pain."],
      ["Connection", "Link the result to code, invariants, complexity, and the graph."]
    ],
    graphTitle: "The graph is the syllabus",
    graphText: "Concept nodes stay connected by prerequisites, contrasts, and uses, so each page has a visible place in the learning map.",
    roadmapText: "Curated paths keep the first version focused while leaving space for algorithms, systems, theory, and data structures."
  },
  zh: {
    kicker: "可探索的实验笔记",
    headline: "用可视化和交互，重新发明计算机科学概念。",
    intro:
      "从具体问题开始，先试朴素想法，看见它为什么不够用，再用可交互的 trace 发明最小的新工具。",
    codeLabel: "trace 快照",
    annotation: "先试一个朴素方法",
    steps: [
      ["问题", "先抓住一个小而真实的痛点，而不是直接背定义。"],
      ["失败", "把第一版想法画出来，看清它在哪里变得吃力。"],
      ["发明", "只加入一个能解决痛点的新工具。"],
      ["连接", "再连接到代码、不变量、复杂度和知识图谱。"]
    ],
    graphTitle: "图谱就是课程结构",
    graphText: "概念节点通过前置、对比、使用关系连接，每一页都能看见自己在学习地图中的位置。",
    roadmapText: "路线图让第一版保持聚焦，同时给算法、系统、理论和数据结构留下扩展空间。"
  }
}[lang];

const homeJsonLd = [
  organizationJsonLd(siteBase),
  websiteJsonLd(lang, siteBase),
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: t(lang, "siteTitle"),
    description: t(lang, "siteDescription"),
    inLanguage: lang === "zh" ? "zh-Hans" : "en",
    url: absoluteUrl(`/${lang}/`, siteBase),
    mainEntity: featured.map((entry) => ({
      "@type": "LearningResource",
      name: entry.data.title,
      description: entry.data.summary,
      url: absoluteUrl(nodePath(lang, entry.data.id), siteBase)
    }))
  }
];
---

<Layout
  lang={lang}
  title={t(lang, "siteTitle")}
  description={t(lang, "siteDescription")}
  pathname={`/${lang}/`}
  availableLocales={localeCodes}
  jsonLd={homeJsonLd}
>
  <section class="home-hero rcl-graph-paper">
    <div class="hero-copy">
      <p class="section-kicker">{copy.kicker}</p>
      <h1>{copy.headline}</h1>
      <p>{copy.intro}</p>
      <div class="rcl-button-row">
        <a class="rcl-button" href="#concepts-title">{t(lang, "startExploring")}</a>
        <a class="rcl-button secondary" href={graphPath(lang)}>{t(lang, "graph")}</a>
      </div>
    </div>
    <div class="hero-visual" aria-label={t(lang, "interactiveLabs")}>
      <img src="/assets/reconceptlab-logo-crop.png" alt="" width="620" height="240" />
      <div class="mini-graph" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
      </div>
      <pre><code>{copy.codeLabel}
queue = [B, C]
visited = {`{A, B, C}`}</code></pre>
      <p>{copy.annotation}</p>
    </div>
  </section>

  <section class="home-section" aria-labelledby="how-title">
    <p class="section-kicker">{t(lang, "howItWorks")}</p>
    <h2 id="how-title">{t(lang, "howItWorks")}</h2>
    <div class="step-grid">
      {copy.steps.map(([title, text], index) => (
        <article class="step-card surface">
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="home-section" aria-labelledby="concepts-title">
    <p class="section-kicker">{t(lang, "featuredConcepts")}</p>
    <h2 id="concepts-title">{t(lang, "concepts")}</h2>
    <div class="grid">
      {featured.map((entry) => <NodeCard entry={entry} lang={lang} />)}
    </div>
  </section>

  <section class="home-split">
    <article class="graph-preview surface rcl-graph-paper">
      <p class="section-kicker">{t(lang, "graph")}</p>
      <h2>{copy.graphTitle}</h2>
      <p>{copy.graphText}</p>
      <a class="rcl-button secondary" href={graphPath(lang)}>{t(lang, "graph")}</a>
    </article>
    <article class="roadmap-preview surface">
      <p class="section-kicker">{t(lang, "roadmapPreview")}</p>
      <h2>{t(lang, "roadmaps")}</h2>
      <p>{copy.roadmapText}</p>
      <a class="rcl-button secondary" href={roadmapPath(lang)}>{t(lang, "roadmaps")}</a>
    </article>
  </section>
</Layout>

<style>
  .home-hero {
    align-items: center;
    background-color: color-mix(in srgb, var(--surface) 88%, transparent);
    border: 1px solid var(--line);
    border-radius: var(--rcl-radius-xl);
    box-shadow: var(--rcl-shadow-md);
    display: grid;
    gap: 28px;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.88fr);
    margin-bottom: 54px;
    overflow: hidden;
    padding: clamp(24px, 5vw, 56px);
  }

  .hero-copy h1 {
    font-size: clamp(2.5rem, 7vw, 5.8rem);
    line-height: 0.96;
    margin: 0 0 18px;
    max-width: 780px;
  }

  .hero-copy p:not(.section-kicker) {
    color: var(--muted);
    font-size: 1.12rem;
    max-width: 620px;
  }

  .hero-visual {
    background: color-mix(in srgb, var(--rcl-surface-lab) 86%, transparent);
    border: 1px solid var(--line);
    border-radius: var(--rcl-radius-lg);
    box-shadow: var(--rcl-shadow-sm);
    display: grid;
    gap: 16px;
    min-width: 0;
    padding: 18px;
  }

  .hero-visual img {
    display: block;
    height: auto;
    max-width: 100%;
  }

  .hero-visual pre {
    margin: 0;
  }

  .hero-visual p {
    background: var(--rcl-secondary-soft);
    border: 1px solid color-mix(in srgb, var(--rcl-secondary) 38%, var(--line));
    border-radius: 999px;
    color: var(--rcl-secondary-strong);
    font-weight: 850;
    margin: 0;
    padding: 8px 12px;
    width: fit-content;
  }

  .mini-graph {
    border: 1px solid var(--line);
    border-radius: var(--rcl-radius-md);
    height: 126px;
    position: relative;
  }

  .mini-graph::before,
  .mini-graph::after {
    background: var(--line);
    content: "";
    height: 2px;
    left: 21%;
    position: absolute;
    top: 50%;
    transform: rotate(18deg);
    width: 58%;
  }

  .mini-graph::after {
    transform: rotate(-24deg);
  }

  .mini-graph span {
    background: var(--rcl-primary-soft);
    border: 3px solid var(--rcl-primary);
    border-radius: 999px;
    height: 26px;
    position: absolute;
    width: 26px;
  }

  .mini-graph span:nth-child(1) {
    left: 18%;
    top: 44%;
  }

  .mini-graph span:nth-child(2) {
    background: var(--rcl-secondary-soft);
    border-color: var(--rcl-secondary);
    left: 44%;
    top: 18%;
  }

  .mini-graph span:nth-child(3) {
    background: var(--rcl-accent-soft);
    border-color: var(--rcl-accent);
    left: 60%;
    top: 58%;
  }

  .mini-graph span:nth-child(4) {
    left: 75%;
    top: 30%;
  }

  .home-section {
    margin: 48px 0;
  }

  .home-section h2,
  .home-split h2 {
    font-size: clamp(1.7rem, 3vw, 2.6rem);
    line-height: 1.05;
    margin: 0 0 18px;
  }

  .step-grid,
  .home-split {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .step-card {
    padding: 18px;
  }

  .step-card span {
    color: var(--rcl-primary);
    font-weight: 900;
  }

  .step-card h3 {
    margin: 8px 0 8px;
  }

  .step-card p,
  .home-split p {
    color: var(--muted);
    margin: 0;
  }

  .graph-preview,
  .roadmap-preview {
    padding: 24px;
  }

  .home-split .rcl-button {
    margin-top: 18px;
  }

  @media (max-width: 820px) {
    .home-hero {
      grid-template-columns: 1fr;
    }
  }
</style>
