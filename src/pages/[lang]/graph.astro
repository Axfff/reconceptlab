---
import Layout from "../../components/Layout.astro";
import GraphExplorer from "../../components/GraphExplorer";
import { graphEdges, graphNodes } from "../../data/graph";
import { localeCodes, type Locale } from "../../i18n/locales";
import { t } from "../../i18n/ui";
import { getNodesByLocale } from "../../lib/content";

export function getStaticPaths() {
  return localeCodes.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const entries = await getNodesByLocale(lang);
const availableNodeIds = entries.map((entry) => entry.data.id);
---

<Layout lang={lang} title={t(lang, "graph")} description={t(lang, "siteDescription")}>
  <section class="prose">
    <h1>{t(lang, "graph")}</h1>
    <p class="summary">{t(lang, "siteDescription")}</p>
  </section>

  <GraphExplorer client:load lang={lang} nodes={graphNodes} edges={graphEdges} availableNodeIds={availableNodeIds} />
</Layout>
